# Copy to .env for local development. Local-only values; never commit real secrets.
# docker compose reads this file automatically; export the APP/DB/S3/MAIL values
# to your shell or IDE run configuration when running the app.

APP_BASE_DOMAIN=lvh.me:8080

# PostgreSQL superuser (container bootstrap only, never used by the app)
POSTGRES_PASSWORD=postgres
DB_NAME=ecommerce

# Database roles (SPEC 4.3)
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/ecommerce
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=app_owner_local
DB_APP_USER=app_user
DB_APP_PASSWORD=app_user_local
DB_PLATFORM_USER=app_platform
DB_PLATFORM_PASSWORD=app_platform_local

# Identity (SPEC 10). The first platform admin is created from these while no platform user exists.
PLATFORM_ADMIN_EMAIL=admin@lvh.me
PLATFORM_ADMIN_PASSWORD=local-admin-pass
# Session cookies are Secure everywhere except plain-http local development.
SESSION_COOKIE_SECURE=false

# Media (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/media

# Email (Mailpit locally)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=

# Messaging (optional)
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

SENTRY_DSN=
JWT_SECRET=
