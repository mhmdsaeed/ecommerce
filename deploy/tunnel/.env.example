# Copy to .env (never committed) and replace every CHANGE_ME with a long random value, for example the output of
#   openssl rand -hex 24      (Git Bash)

# Your domain on Cloudflare: stores open at <slug>.<domain>, the platform admin at admin.<domain>.
DOMAIN=example.com

POSTGRES_PASSWORD=CHANGE_ME
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_PLATFORM_PASSWORD=CHANGE_ME

# MinIO's administrator, which the app also uses (at least 8 characters).
S3_ACCESS_KEY=media-admin
S3_SECRET_KEY=CHANGE_ME

# The first platform admin, created on the first start. Remove both lines (and restart) once you have signed in.
PLATFORM_ADMIN_EMAIL=you@example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME

# Optional
JWT_SECRET=
BILLING_PAY_TO=
# Texts and their codes go to the app's log in full (false: masked, as in production).
# LOG_MESSAGES=true
# APP_IMAGE=ecommerce:latest
# MAILPIT_PORT=8025
